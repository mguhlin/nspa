{
  "name": "trust-under-pressure",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/content.test.ts",
    "test:browser": "playwright test",
    "build": "node scripts/prepare-public.mjs && python3 scripts/build-intro.py && npm run validate && npm run typecheck && vite build && node scripts/check-assets.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
